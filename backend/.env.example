# Copy to .env. Never commit your real .env or put secrets in VITE_* variables.
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=sociallens
